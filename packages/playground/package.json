{
  "name": "@stencil/playground",
  "version": "5.0.0-beta.0",
  "description": "In-browser live playground for writing and previewing Stencil components",
  "homepage": "https://stenciljs.com/",
  "license": "MIT",
  "author": "StencilJs Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stenciljs/core.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/loader-bundle/index.js",
  "module": "dist/loader-bundle/index.js",
  "types": "dist/types/components.d.ts",
  "scripts": {
    "start": "stencil build --serve --dev --watch",
    "build": "stencil build && node build/copy-vendor.js",
    "typecheck": "tsc --noEmit",
    "test:browser": "vitest run"
  },
  "dependencies": {
    "@stencil/core": "workspace:*"
  },
  "devDependencies": {
    "@preact/signals-core": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "collection": "dist/collection/collection-manifest.json"
}
